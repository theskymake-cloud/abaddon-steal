local Tabs, Pages = {}, {}
local function setTab(name)
    for n, t in pairs(Tabs) do
        local a = n == name
        t.lbl.TextColor3 = a and C.White or C.TextDim
        t.bar.Visible = a
        Pages[n].Visible = a
    end
end
local function createTab(name, order)
    local btn = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false, LayoutOrder = order, ZIndex = 4,
    }, TabList)
    local bar = new("Frame", {
        Size = UDim2.fromOffset(2, 14), Position = UDim2.new(0, 0, 0.5, -7),
        BackgroundColor3 = C.White, BorderSizePixel = 0, Visible = false, ZIndex = 5,
    }, btn)
    local lbl = new("TextLabel", {
        Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1, Text = name:lower(),
        TextColor3 = C.TextDim, TextSize = 12, Font = FONT,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
    }, btn)
    btn.MouseEnter:Connect(function() if Pages[name] and Pages[name].Visible then return end tween(lbl, 0.08, { TextColor3 = C.Text }) end)
    btn.MouseLeave:Connect(function() if Pages[name] and Pages[name].Visible then return end tween(lbl, 0.1, { TextColor3 = C.TextDim }) end)
