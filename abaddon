-- диагностика: какие скрипты читают вес и трогают WalkSpeed
local function findSpeedScript()
    if not decompile then logErr("decompile not supported") return end
    local pool = {}
    for _, s in ipairs(getscripts and getscripts() or {}) do pool[#pool + 1] = s end
    for _, s in ipairs(getloadedmodules and getloadedmodules() or {}) do pool[#pool + 1] = s end
    local found = 0
    for _, s in ipairs(pool) do
        local ok, src = pcall(decompile, s)
        if ok and type(src) == "string" and src:find("CarryWeight", 1, true) then
            found += 1
            print(string.format("=== %s (%d chars) WalkSpeed=%s", s:GetFullName(), #src,
                tostring(src:find("WalkSpeed", 1, true) ~= nil)))
            local c = 0
            for line in src:gmatch("[^\n]+") do
                if line:find("CarryWeight", 1, true) or line:find("WalkSpeed", 1, true) then
                    print("  " .. line)
                    c += 1
                    if c > 25 then break end
                end
            end
        end
    end
    logOk("Scripts using CarryWeight: " .. found .. " (F9)")
end

