        out[#out + 1] = "  " .. c:GetFullName():sub(#best:GetFullName() + 2) .. " [" .. c.ClassName .. "]" .. extra
        for k, v in pairs(c:GetAttributes()) do out[#out + 1] = "    attr " .. k .. " = " .. tostring(v) end
    end
    print("[Abaddon] nearest loot:\n" .. table.concat(out, "\n"))
