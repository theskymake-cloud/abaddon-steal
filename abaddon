local function drop(tbl, k)
    local e = tbl[k]
    if not e then return end
    tbl[k] = nil
    pcall(function() e.bb:Destroy() end)
    if e.ol    then pcall(function() e.ol:Destroy()    end) end
    if e.light then pcall(function() e.light:Destroy() end) end
end

-- HL лимит Roblox ~31 одновременно
local HL_MAX = 30

-- kind: "hl" (Highlight, лимит ~31) | "box" (SelectionBox, без лимита) | nil
local function put(tbl, key, adornee, text, col, outlineTarget, kind, fill, secret)
    local e = tbl[key]
    if e and (not e.bb.Parent or e.adornee ~= adornee or e.kind ~= kind) then
        drop(tbl, key) e = nil
    end
    if not e then
        local bb = new("BillboardGui", {
            Name = "AbaddonESP", Adornee = adornee, AlwaysOnTop = true,
            Size = secret and UDim2.fromOffset(260, 56) or UDim2.fromOffset(200, 44),
            StudsOffset = Vector3.new(0, secret and 3.2 or 2.5, 0), ResetOnSpawn = false,
        }, ScreenGui)
        local l = new("TextLabel", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            TextSize = secret and 14 or 11, Font = FONT,
            TextStrokeTransparency = secret and 0 or 0.3,
            TextStrokeColor3 = secret and rgb(0, 60, 55) or C.Black,
            TextWrapped = true, ZIndex = 2,
        }, bb)
        local ol
        if kind == "hl" then
            ol = new("Highlight", {
                Adornee = outlineTarget,
                FillTransparency = fill or 1,
                OutlineTransparency = 0,
                DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
            }, ScreenGui)
        elseif kind == "box" then
            ol = new("SelectionBox", {
                Adornee = outlineTarget,
                LineThickness = secret and 0.06 or 0.03,
                SurfaceTransparency = 1,
            }, ScreenGui)
        end
        local light
        if secret and adornee:IsA("BasePart") then
            light = new("PointLight", { Color = SECRET_COL, Brightness = 3, Range = 16, Shadows = false }, adornee)
        end
        e = { bb = bb, lbl = l, ol = ol, light = light, adornee = adornee, kind = kind, secret = secret }
        tbl[key] = e
    end

    e.lbl.Text       = text
    e.lbl.TextColor3 = col

    if e.ol and not e.secret then
        if e.kind == "hl" then
            e.ol.OutlineColor = col
            e.ol.FillColor    = col
        else
            e.ol.Color3 = col
        end
    end
end

