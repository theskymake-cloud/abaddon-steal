local function dumpNearestLoot()
    if next(tmpl) == nil then loadTemplates() end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local best, bd
    for _, o in ipairs(workspace:GetDescendants()) do
        if (o:IsA("Model") or o:IsA("Tool") or o:IsA("BasePart")) and resolveTemplate(o.Name) and not inPlayer(o) then
            local p = partOf(o)
            if p then
                local d = (p.Position - cam.CFrame.Position).Magnitude
                if not bd or d < bd then best, bd = o, d end
