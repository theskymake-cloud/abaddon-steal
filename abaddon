-- быстрые ремоуты из дампа
local function fireRemote(name, ...)
    local args = { ... }  -- захватываем vararg до входа в анонимную функцию
    local r = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild(name)
    if not r then
        for _, d in ipairs(RS:GetDescendants()) do
            if d.Name == name and (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) then r = d break end
        end
    end
    if not r then logErr("Remote not found: " .. name) return false end
    local ok, err = pcall(function()
        if r:IsA("RemoteFunction") then r:InvokeServer(table.unpack(args))
        else r:FireServer(table.unpack(args)) end
    end)
    if not ok then logErr("Fire error: " .. tostring(err)) return false end
    logOk("Fired: " .. name)
    return true
end

