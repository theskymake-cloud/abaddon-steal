local sumLbl

-- ==================== STEP ====================
local function step()
    local cam = workspace.CurrentCamera
    local origin = cam and cam.CFrame.Position
    if not origin then return end
    local hlUsed = 0

    -- 1) Entities
    local seenE = {}
    if State.EntESP then
        local ents = {}
        for _, m in ipairs(CollectionService:GetTagged("Entity")) do
            if m:IsA("Model") and m:IsDescendantOf(workspace) and m:GetAttribute("State") ~= nil then
                ents[m] = true
            end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            local ch = plr.Character
            if plr ~= LP and ch and ch:GetAttribute("PlayerEntity") ~= nil then ents[ch] = true end
        end
        for m in pairs(ents) do
            local root = rootOf(m)
            if root then
                local d = (root.Position - origin).Magnitude
                if d <= State.EntRange then
                    local kind
                    if State.CharOutline and hlUsed < HL_MAX then kind = "hl" hlUsed += 1 end
                    seenE[m] = true
                    local st = tostring(m:GetAttribute("State") or "player")
                    put(entEsp, m, root,
                        string.format("ENTITY %s\n%s  |  %dm", m.Name, st, math.floor(d)),
                        ENT_COL, m, kind, 0.75)
                end
            end
        end
    end
    for k in pairs(entEsp) do if not seenE[k] then drop(entEsp, k) end end

    -- 2) Survivors
    local seenS = {}
    if State.SurvESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            local ch = plr.Character
            if plr ~= LP and ch and ch:GetAttribute("PlayerEntity") == nil then
                local hum  = ch:FindFirstChildOfClass("Humanoid")
                local root = ch:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    local d = (root.Position - origin).Magnitude
                    if d <= State.SurvRange then
                        local st
                        if plr:GetAttribute("Hiding") then st = "hiding"
                        elseif plr:GetAttribute("Grabbed") or plr:GetAttribute("BeingKilled") then st = "caught!"
                        elseif plr:GetAttribute("InMatch") then st = "$" .. commas(plr:GetAttribute("Money") or 0)
                        else st = "lobby" end
                        local kind
                        if State.CharOutline and hlUsed < HL_MAX then kind = "hl" hlUsed += 1 end
                        seenS[ch] = true
                        put(survEsp, ch, root,
                            string.format("%s\n%s  |  %dm", plr.DisplayName, st, math.floor(d)),
                            SURV_COL, ch, kind, 0.8)
                    end
                end
            end
        end
    end
    for k in pairs(survEsp) do if not seenS[k] then drop(survEsp, k) end end

    -- 3) Loot — улучшенный
    local seenL, n, kgSum, valSum = {}, 0, 0, 0
        local topThr = 0

    if State.LootESP then
        if os.clock() - lastScan > 10 then lastScan = os.clock() scanLootAsync() end

        -- собираем кандидатов в зоне
        local cands = {}
        for _, r in ipairs(lootList) do
            if r.inst.Parent and r.part.Parent then
                local d = (r.part.Position - origin).Magnitude
                if d <= State.LootRange then
                    cands[#cands + 1] = { r = r, d = d }
                    n   += 1
                    kgSum  += r.kg
                    valSum += r.cost
                end
            end
        end

        -- сортируем по убыванию стоимости, чтобы определить топ-N
        table.sort(cands, function(a, b) return a.r.cost > b.r.cost end)
        local topC = cands[math.min(State.TopN, #cands)]
        topThr = topC and topC.r.cost or 0

        -- топ-N самых дорогих (ключи для быстрой проверки)
        local topSet = {}
        if State.TopHighlight then
            for i = 1, math.min(State.TopN, #cands) do
                topSet[cands[i].r.inst] = true
            end
        end

        -- сортируем по расстоянию для распределения Highlight/Box
        table.sort(cands, function(a, b)
            local sa = a.r.rarity and a.r.rarity:lower() == "secret"
            local sb = b.r.rarity and b.r.rarity:lower() == "secret"
            if sa ~= sb then return sa end
            return a.d < b.d
        end)

        for i, c in ipairs(cands) do
            if i > 200 then break end
            local r      = c.r
            local secret = r.rarity ~= nil and r.rarity:lower() == "secret"
            local isTop  = topSet[r.inst] == true
            local rarCol = r.rarity and RAR[r.rarity] or C.White
            local col    = isTop and brightenMore(rarCol) or rarCol
            if secret then col = SECRET_COL end

            local kind
            if secret and hlUsed < HL_MAX then
                kind = "hl" hlUsed += 1            -- секретные светятся даже при выключенном outline
            elseif State.LootOutline then
                if hlUsed < HL_MAX then
                    kind = "hl" hlUsed += 1
                else
                    kind = "box"
                end
            end

            seenL[r.inst] = true

            local title = r.name .. (r.rarity and ("  [" .. r.rarity .. "]") or "")
            if secret then title = "◉ " .. title .. " ◉" end
            put(lootEsp, r.inst, r.part,
                string.format("%s\n%.1f kg  |  $%s  |  %dm", title, r.kg, commas(r.cost), math.floor(c.d)),
                col, r.inst, kind, 1, secret)
        end
    end
    for k in pairs(lootEsp) do if not seenL[k] then drop(lootEsp, k) end end

    -- итоговая строка
    if sumLbl then
        if State.LootESP then
            sumLbl.Text = string.format(
                "in range: %d items  |  %.1f kg  |  $%s\ntop-%d threshold: $%s+",
                n, kgSum, commas(valSum), State.TopN, commas(topThr))
        else
            sumLbl.Text = "loot esp off"
        end
    end

    -- 4) Round HUD
    Hud.Visible = State.RoundHUD
    if State.RoundHUD then
        local lines = {}
        local rd = RS:FindFirstChild("Round")
        if rd then
            local ph   = tostring(rd:GetAttribute("Phase") or "?")
            local left = math.max(0, math.floor((rd:GetAttribute("PhaseEnds") or 0) - workspace:GetServerTimeNow() + 0.5))
            local map  = rd:GetAttribute("Map")
            lines[1] = string.format('<b>%s</b>  %d:%02d%s', ph, left // 60, left % 60,
                (type(map) == "string" and map ~= "") and ("  " .. map) or "")
        else
            lines[1] = "no Round object"
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if #lines < 14 then
                lines[#lines + 1] = string.format(
                    '%s  <font color="#787878">Lv%s  x%s  $%s</font>',
                    p.DisplayName,
                    tostring(p:GetAttribute("Level") or 1),
                    tostring(p:GetAttribute("EntityChance") or 1),
                    commas(p:GetAttribute("Bank") or 0))
            end
        end
        HudL.Text = table.concat(lines, "\n")
    end
end

