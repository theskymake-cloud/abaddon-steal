local tmpl = {}
local function collectTemplates(inst)
    for _, c in ipairs(inst:GetChildren()) do
        if c:IsA("Folder") then collectTemplates(c)
        elseif c:IsA("Model") or c:IsA("Tool") or c:IsA("BasePart") then tmpl[c.Name] = c end
    end
end
local function loadTemplates()
    tmpl = {}
    local lt = RS:FindFirstChild("LootTemplates")
    if lt then collectTemplates(lt) end
end

local WEIGHT = { "weight", "kg", "mass" }
local VALUE  = { "value", "price", "cost", "worth", "sell" }
local function nameHas(n, list)
    n = n:lower()
    for _, w in ipairs(list) do if n:find(w, 1, true) then return true end end
    return false
end
local function readStat(inst, list)
    if not inst then return nil end
    for k, v in pairs(inst:GetAttributes()) do
        if type(v) == "number" and nameHas(k, list) then return v end
    end
    for _, c in ipairs(inst:GetChildren()) do
        if (c:IsA("NumberValue") or c:IsA("IntValue")) and nameHas(c.Name, list) then return c.Value end
    end
    for _, c in ipairs(inst:GetChildren()) do
        if c:IsA("Configuration") or c:IsA("Folder") then
            local r = readStat(c, list)
            if r then return r end
        end
    end
    return nil
end
local function statFromTable(t, list)
    if type(t) ~= "table" then return nil end
    for k, v in pairs(t) do
        if type(k) == "string" and type(v) == "number" and nameHas(k, list) then return v end
    end
    return nil
end

local function rarityFrom(v, allowNum)
    if type(v) == "string" then
        local l = v:lower()
        for name in pairs(RAR) do if name:lower() == l then return name end end
    elseif allowNum and type(v) == "number" and RAR_LIST[v] then
        return RAR_LIST[v]
    end
    return nil
end
local function readRarity(inst)
    for k, v in pairs(inst:GetAttributes()) do
        if k:lower():find("rarity", 1, true) then
            local r = rarityFrom(v, true) if r then return r end
        end
    end
    for _, c in ipairs(inst:GetChildren()) do
        if c:IsA("ValueBase") and c.Name:lower():find("rarity", 1, true) then
            local r = rarityFrom(c.Value, true) if r then return r end
        end
    end
    for _, v in pairs(inst:GetAttributes()) do
        if type(v) == "string" then
            local r = rarityFrom(v, false) if r then return r end
        end
    end
    local a = inst.Parent
    while a and a ~= workspace do
        local r = rarityFrom(a.Name, false) if r then return r end
        a = a.Parent
    end
    return nil
end

local function partOf(o)
    if o:IsA("BasePart") then return o end
    if o:IsA("Tool")  then return o:FindFirstChild("Handle") or o:FindFirstChildWhichIsA("BasePart", true) end
    if o:IsA("Model") then return o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart", true) end
end
local function inPlayer(o)
    local a = o.Parent
    while a and a ~= workspace do
        if a:IsA("Model") and Players:GetPlayerFromCharacter(a) then return true end
        a = a.Parent
    end
    return false
end
local function resolveTemplate(name)
    if tmpl[name] then return tmpl[name], name end
    local base = name:gsub("%s*%(?%d+%)?$", "")
    if tmpl[base] then return tmpl[base], base end
    return nil
end

local function commas(n)
    local s = tostring(math.floor((tonumber(n) or 0) + 0.5))
    return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end

local lootList, lastScan = {}, 0
local LOOT_CLASS = { Model = true, Tool = true, Part = true, MeshPart = true, UnionOperation = true, WedgePart = true }

local function scanLoot()
    if next(tmpl) == nil then loadTemplates() end
    local out, matched = {}, {}
    local all = workspace:GetDescendants()
    local t0 = os.clock()
    for i = 1, #all do
        local o = all[i]
        if LOOT_CLASS[o.ClassName] then
            local nm = o.Name
            local t, tname = tmpl[nm], nm
            if not t and nm:find("[%d%)]$") then t, tname = resolveTemplate(nm) end
            if t and not inPlayer(o) then
                local skip, a = false, o.Parent
                while a and a ~= workspace do
                    if matched[a] then skip = true break end
                    a = a.Parent
                end
                if not skip then
                    matched[o] = true
                    local p = partOf(o)
                    if p then
                        local def = ITEM_BY_KEY[tname] or ITEM_BY_DISPLAY[tname]
                        local kg   = readStat(o, WEIGHT) or readStat(t, WEIGHT) or statFromTable(def, WEIGHT)
                        local cost = readStat(o, VALUE)  or readStat(t, VALUE)  or statFromTable(def, VALUE)
                        if kg and cost then
                            out[#out + 1] = {
                                inst = o, part = p, kg = kg, cost = cost,
                                name = (type(def) == "table" and def.displayName) or o.Name,
                                rarity = readRarity(o),
                            }
                        end
                    end
                end
            end
        end
        if i % 500 == 0 and os.clock() - t0 > 0.004 then
            task.wait()
            t0 = os.clock()
        end
    end
    lootList = out
end

local scanningLoot = false
local function scanLootAsync()
    if scanningLoot then return end
    scanningLoot = true
    task.spawn(function()
        pcall(scanLoot)
        scanningLoot = false
    end)
end

