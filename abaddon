            if d:IsA("LocalScript") and d.Name == "AdminPanel" then target = d break end
        end
    end
    if not target then logErr("AdminPanel script not found") return end
    log("Found: " .. target:GetFullName())
    local env = setmetatable({ script = target }, { __index = (getgenv and getgenv()) or getfenv(0) })
    local fn
    if getscriptclosure and debug and debug.getconstants and debug.setconstant then
        local ok, f = pcall(getscriptclosure, target)
        if ok and type(f) == "function" then
            local ok2, ks = pcall(debug.getconstants, f)
            local patched = 0
            if ok2 and type(ks) == "table" then
                for i, k in pairs(ks) do
                    if type(k) == "number" and OWNER_IDS[k] then
                        if pcall(debug.setconstant, f, i, LP.UserId) then patched += 1 end
                    end
                end
            end
            if patched > 0 then fn = f log("Patched constants: " .. patched) end
        end
    end
    if not fn and decompile and loadstring then
        local ok, src = pcall(decompile, target)
        if ok and type(src) == "string" and #src > 100 then
            local n = 0
            for id in pairs(OWNER_IDS) do
                local c src, c = src:gsub("%[" .. id .. "%]", "[" .. LP.UserId .. "]") n += c
            end
            local f, err = loadstring(src)
            if f and n > 0 then fn = f logOk("Decompiled + patched: " .. n)
            else logErr("Decompile patch failed: " .. tostring(err or "ids not found")) end
        end
    end
    if not fn then logErr("No method worked: executor lacks setconstant/decompile") return end
    pcall(setfenv, fn, env)
    task.spawn(function()
        local ok, err = pcall(fn)
        if not ok then logErr("Admin script error: " .. tostring(err)) end
    end)
    task.delay(1.5, function()
        local g = LP:FindFirstChildOfClass("PlayerGui")
        log(g and g:FindFirstChild("AdminPanel") and "Admin panel ready: press U" or "Ran, but no panel appeared")
    end)
end

