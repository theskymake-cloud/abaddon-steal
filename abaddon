-- влезает ли предмет в сумку (та же логика, что в PickupPrompt)
local function bagFits(par)
    local key = par:GetAttribute("ItemKey")
    local def = (GC and type(key) == "string" and type(GC.Items) == "table") and GC.Items[key] or nil
    if type(def) == "table" and def.armsOnly then return false end
    local w   = par:GetAttribute("Weight") or 0
    local cur = LP:GetAttribute("CarryWeight") or 0
    local cap = LP:GetAttribute("CarryCapacity") or (GC and GC.CarryCapacity) or 0
    return cur + w <= cap + 0.000001
end

