local closeOpenDD
local function dropdown(parent, label, options, key, cb)
    local r = row(parent, 22)
    r.ClipsDescendants = true
    new("TextLabel", {
        Size = UDim2.new(1, -118, 0, 22), BackgroundTransparency = 1, Text = label,
        TextColor3 = C.Text, TextSize = 11, Font = FONT,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4,
    }, r)

    local idx = table.find(options, State[key]) or 1
    State[key] = options[idx]

    local btn = new("TextButton", {
        Size = UDim2.fromOffset(112, 18), Position = UDim2.new(1, -112, 0, 2),
        BackgroundColor3 = C.Field, Text = options[idx], TextColor3 = C.Accent,
        TextSize = 10, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 6,
    }, r)
    new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 16) }, btn)
    stroke(btn, C.Black) gloss(btn, rgb(170, 170, 170))
    local arrow = new("TextLabel", {
        Size = UDim2.fromOffset(14, 18), Position = UDim2.new(1, -14, 0, 2), BackgroundTransparency = 1,
        Text = "v", TextColor3 = C.TextDim, TextSize = 9, Font = FONT, ZIndex = 7,
    }, r)

    local H = #options * 18
    local list = new("Frame", {
        Size = UDim2.fromOffset(112, H), Position = UDim2.new(1, -112, 0, 24),
        BackgroundColor3 = rgb(10, 10, 10), BackgroundTransparency = 0.12,
        BorderSizePixel = 0, Visible = false, ZIndex = 9,
    }, r)
    stroke(list, C.Border)

    local optBtns = {}
    local function paint()
        for i, b in ipairs(optBtns) do b.TextColor3 = (i == idx) and C.Accent or C.TextDim end
    end

    local isOpen = false
    local function close()
        if not isOpen then return end
        isOpen = false
        arrow.Text = "v"
        tween(r, 0.12, { Size = UDim2.new(1, 0, 0, 22) })
        task.delay(0.13, function() if not isOpen then list.Visible = false end end)
    end
    local function open()
        if closeOpenDD and closeOpenDD ~= close then closeOpenDD() end
        closeOpenDD = close
        isOpen = true
        arrow.Text = "^"
        list.Visible = true
        tween(r, 0.15, { Size = UDim2.new(1, 0, 0, 24 + H + 2) })
    end

    for i, o in ipairs(options) do
        local b = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, (i - 1) * 18),
            BackgroundColor3 = C.FieldHov, BackgroundTransparency = 1, Text = o, TextColor3 = C.TextDim,
            TextSize = 10, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 10,
        }, list)
        new("UIPadding", { PaddingLeft = UDim.new(0, 6) }, b)
        b.MouseEnter:Connect(function() b.BackgroundTransparency = 0.4 end)
        b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
        b.MouseButton1Click:Connect(function()
            idx = i
            State[key] = options[i]
            btn.Text = options[i]
            paint()
            close()
            if cb then cb(options[i]) end
        end)
        optBtns[i] = b
    end
    paint()
    btn.MouseButton1Click:Connect(function() if isOpen then close() else open() end end)
end

