    Legendary = rgb(245, 175, 40),
    Secret    = SECRET_COL,
}
local RAR_ORDER = { Common = 1, Uncommon = 2, Rare = 3, Mythic = 4, Legendary = 5, Secret = 6 }

local function brighten(c)
    local h, s, v = c:ToHSV()
    if v < 0.55 then return Color3.fromHSV(h, s * 0.6, 0.9) end
    return c
end
local function brightenMore(c)
    -- для топ предметов: увеличиваем яркость и насыщенность
    local h, s, v = c:ToHSV()
    return Color3.fromHSV(h, math.min(1, s * 0.7 + 0.1), math.min(1, v * 0.8 + 0.35))
end

local function loadConfig()
    RAR, RAR_LIST, ITEM_BY_KEY, ITEM_BY_DISPLAY = {}, {}, {}, {}
    local m = RS:FindFirstChild("GameConfig") or RS:WaitForChild("GameConfig", 5)
    if m then
        local ok, cfg = pcall(require, m)
        if ok and type(cfg) == "table" then
            GC = cfg
            if type(cfg.Rarities) == "table" then
                for i, r in ipairs(cfg.Rarities) do
                    if type(r) == "table" and r.name then
                        RAR[r.name] = typeof(r.colour) == "Color3" and brighten(r.colour) or FALLBACK[r.name] or C.White
                        RAR_LIST[i] = r.name
                    end
                end
            end
            if type(cfg.Items) == "table" then
                for k, d in pairs(cfg.Items) do
                    ITEM_BY_KEY[k] = d
                    if type(d) == "table" and d.displayName then ITEM_BY_DISPLAY[d.displayName] = d end
                end
            end
        end
    end
    for name in pairs(RAR) do
        if name:lower() == "secret" then RAR[name] = SECRET_COL end
    end
    for n, c in pairs(FALLBACK) do RAR[n] = RAR[n] or c end
end

