-- hold=true: настоящий ввод (InputHoldBegin/End), hold=false: fireproximityprompt
local function triggerPrompt(p, hold)
    local old = p.HoldDuration
    pcall(function() p.HoldDuration = 0 p.RequiresLineOfSight = false end)
    local ok
    if hold then
        ok = pcall(function()
            p:InputHoldBegin()
            task.wait(0.06)
            p:InputHoldEnd()
        end)
    else
        if not fireproximityprompt then
            if not warnedNoFire then
                warnedNoFire = true
                logErr("fireproximityprompt not supported, use Prompt (hold) or Remote")
            end
            return false
        end
        ok = pcall(fireproximityprompt, p)
    end
    -- возвращаем прежний HoldDuration, если Instant Collect выключен
    if not State.InstantCollect then
        task.delay(0.5, function()
            if p.Parent then pcall(function() p.HoldDuration = old end) end
        end)
    end
    return ok
end

local function doPromptTP(p, par, hold)
    local root, pos = myRoot(), posOfInst(par)
    if not (root and pos) then return false end
    local origin = root.CFrame
    root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    root.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.15)
    local ok = triggerPrompt(p, hold)
    task.wait(0.12)
    root.CFrame = origin
    return ok
end

local function doRemote(p, par)
    local ev = getPickupRemote()
    if not ev then logErr("PickupLoot remote not found") return false end
    local args
    if PL.args then
        args = table.pack(table.unpack(PL.args, 1, PL.args.n))
        for i = 1, args.n do
            local k = PL.kinds[i]
            if k == "prompt" then args[i] = p
            elseif k == "model" then args[i] = par:FindFirstAncestorOfClass("Model") or par.Parent
            elseif k == "part" then args[i] = par end
        end
    else
        if not warnedLearn then
            warnedLearn = true
            logWarn("Remote: pick up one item by hand so the args can be learned")
        end
        args = table.pack(par)
    end
    _G.AbaddonPickupOwn = true
    local ok, err = pcall(function() ev:FireServer(table.unpack(args, 1, args.n)) end)
    _G.AbaddonPickupOwn = false
    if not ok then logErr("PickupLoot error: " .. tostring(err)) end
    return ok
end

-- реально ли предмет забрали: исчез или вырос вес
local function wasCollected(p, par, w0)
    local t = os.clock()
    repeat
        task.wait(0.05)
        if not p.Parent or not par.Parent or not par:IsDescendantOf(workspace) then return true end
        if (LP:GetAttribute("CarryWeight") or 0) > w0 + 0.000001 then return true end
    until os.clock() - t > 0.5
    return false
end

local cool, failN = setmetatable({}, { __mode = "k" }), setmetatable({}, { __mode = "k" })
local lastFailLog = 0

local function collectStep()
    local root = myRoot()
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end
    if LP:GetAttribute("IsEntity") == true then return end

    local minRank = rarRank(State.CollectMinRarity)
    local best, bestD, bestPar
    for p in pairs(lootPrompts) do
        local par = p.Parent
        if not par then
            lootPrompts[p] = nil
        elseif p.Enabled and (not cool[p] or os.clock() > cool[p]) then
            local rar = par:GetAttribute("Rarity")
            if type(rar) == "string" and not par:GetAttribute("Tool") and rarRank(rar) >= minRank then
                local pos = posOfInst(par)
                if pos then
                    local d = (pos - root.Position).Magnitude
                    local lim = State.CollectRange
                    if State.CollectMethod == "Prompt" or State.CollectMethod == "Prompt (hold)" then
                        lim = math.min(lim, p.MaxActivationDistance)
                    end
                    if d <= lim and (not bestD or d < bestD) and bagFits(par) then
                        best, bestD, bestPar = p, d, par
                    end
                end
            end
        end
    end
    if not best then return end

    local w0 = LP:GetAttribute("CarryWeight") or 0
    local m, ok = State.CollectMethod, false
    if m == "Remote" then ok = doRemote(best, bestPar)
    elseif m == "Prompt + TP" then ok = doPromptTP(best, bestPar, true)
    elseif m == "Prompt" then ok = triggerPrompt(best, false)
    else ok = triggerPrompt(best, true) end

    local name = tostring(bestPar:GetAttribute("ItemKey") or best.ObjectText)
    if ok and wasCollected(best, bestPar, w0) then
        failN[best] = nil
        cool[best] = os.clock() + 1
        log("Collected: " .. name .. " [" .. tostring(bestPar:GetAttribute("Rarity")) .. "]")
    else
        failN[best] = (failN[best] or 0) + 1
        cool[best] = os.clock() + (failN[best] >= 3 and 12 or 2)
        if os.clock() - lastFailLog > 4 then
            lastFailLog = os.clock()
            logWarn(string.format("Not collected (%s): %s - try another method", m, name))
        end
    end
end

